### Base variables for VS Code REST Client extension
@baseUrl = http://localhost:5000
@token = paste_token_here
@taskId = paste_task_id_here

### 1. Health check
GET {{baseUrl}}/health

### 2. Visual DB state
GET {{baseUrl}}/api/visual/db-state

### 3. Register user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Aisha Rahman",
  "email": "aisha@example.com",
  "password": "password123"
}

### 4. Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "aisha@example.com",
  "password": "password123"
}

### 5. My profile
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### 6. Create task
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Learn Mongoose validation",
  "description": "Try valid and invalid payloads and inspect Mongo Express.",
  "status": "todo",
  "priority": 4,
  "tags": ["mongoose", "validation"]
}

### 7. Get my tasks
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}

### 8. Filter tasks by status
GET {{baseUrl}}/api/tasks?status=todo&page=1&limit=5
Authorization: Bearer {{token}}

### 9. Get one task
GET {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}

### 10. Update one task
PUT {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "doing",
  "priority": 5
}

### 11. Delete task
DELETE {{baseUrl}}/api/tasks/{{taskId}}
Authorization: Bearer {{token}}

### 12. Validation failure demo
POST {{baseUrl}}/api/tasks
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "x",
  "status": "blocked",
  "priority": 10
}
